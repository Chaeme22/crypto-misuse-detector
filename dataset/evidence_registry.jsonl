{"evidence_id": "EVID-NIST-800-38A-ECB-001", "authority_type": "standard", "publisher": "NIST", "title": "Recommendation for Block Cipher Modes of Operation", "document_id": "NIST.SP.800-38A", "revision": "2001", "source_uri": null, "local_path": "../NIST/Recommendation for Block Cipher Modes of Operation.pdf", "document_sha256": "sha256:66821162de1e7130c5fb5eedb22140d8d6d013ec51af4550bb095c2a9481a00e", "section_path": ["6 Confidentiality Modes", "6.1 The Electronic Codebook Mode"], "clause_id": "6.1", "page_start": 16, "page_end": 16, "page_basis": "parsed_pdf_page", "table_id": null, "quote": "In the ECB mode, under a given key, any given plaintext block always gets encrypted to the same ciphertext block. If this property is undesirable in a particular application, the ECB mode should not be used.", "quote_hash": "sha256:9da2e78e2fe030aaecb080c2b66b702c7aa29d467ee01e624381d2dc952fe97c", "normative_relation": "recommends", "misuse_ids": ["MISUSE-MODE-ECB"], "cwe_ids": ["CWE-327"], "machine_source": "data/chunks/Recommendation for Block Cipher Modes of Operation.json#chunk_index=9", "verified": false, "verified_by": null, "verified_at": null, "verification_note": "자동 추출 후보. 원문 PDF와 대조 필요", "license_note": "공공 배포 문서. 최소 인용만 저장"}
{"evidence_id": "EVID-NIST-800-38A-IV-001", "authority_type": "standard", "publisher": "NIST", "title": "Recommendation for Block Cipher Modes of Operation", "document_id": "NIST.SP.800-38A", "revision": "2001", "source_uri": null, "local_path": "../NIST/Recommendation for Block Cipher Modes of Operation.pdf", "document_sha256": "sha256:66821162de1e7130c5fb5eedb22140d8d6d013ec51af4550bb095c2a9481a00e", "section_path": ["6 Confidentiality Modes", "6.2 The Cipher Block Chaining Mode"], "clause_id": "6.2", "page_start": 17, "page_end": 17, "page_basis": "parsed_pdf_page", "table_id": null, "quote": "The IV need not be secret, but it must be unpredictable; the generation of such IVs is discussed in Appendix C.", "quote_hash": "sha256:7e363e3d62871aad60cc82bb1b3b40338ea001abc0c9d3a7a85ba36326e31865", "normative_relation": "requires", "misuse_ids": ["MISUSE-IV-STATIC"], "cwe_ids": ["CWE-329"], "machine_source": "data/chunks/Recommendation for Block Cipher Modes of Operation.json#chunk_index=10", "verified": false, "verified_by": null, "verified_at": null, "verification_note": "자동 추출 후보. 원문 PDF와 대조 필요", "license_note": "공공 배포 문서. 최소 인용만 저장"}
